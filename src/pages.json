  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationStyle": "custom",
        "enablePullDownRefresh": true,
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/lesson/detail",
      "style": {
        "navigationBarTitleText": "Listening room"
      }
    },
    {
      "path": "pages/import/index",
      "style": {
        "navigationBarTitleText": "Import an article",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/admin/review",

import type { Lesson, LessonParagraph, LessonSentence, LessonWord } from '@/types/lesson'
import { wordTimes } from './wordtimes'

/**
 * Mock 课程数据（第一阶段）
 *
 * 5 篇英文小故事（A1/A2/B1），内容为原创，未抄袭任何网站文章。
 * 原文按段落整段排版：每段含小节标题与句子数组；生词表用于原文内首次出现时做标记。
 *
 * 真实音频（2026-10-27 合成，v17 起改用 Piper Amy 女声）：逐句合成、拼接成整课音频；v19 起音频托管在微信云存储（云文件 ID，永久有效），不再用 48 小时试听地址。
 * 句子时间戳为每句实测时长累加；音频暂托管在 Muse 内置存储（48 小时有效期，
 * 到期后重新上传替换地址即可），正式版迁移到微信云存储。
 */

/** 由“小节标题 + 英文/中文句子对”生成带估算时间戳的段落数组 */
function buildParagraphs(
  raw: Array<{ heading: string; lines: Array<[string, string]> }>,
  durations: number[],
  words?: LessonWord[][],
): LessonParagraph[] {
  let t = 0
  let i = 0
  return raw.map((para) => ({
    heading: para.heading,
    sentences: para.lines.map(([text, translation]): LessonSentence => {
      const d = durations[i++] ?? 3
      const s: LessonSentence = { text, translation, startTime: round2(t), endTime: round2(t + d) }
      // 单词级时间戳：按全局句子顺序取；缺省时详情页按词长比例估算
      if (words && words[i - 1]) s.words = words[i - 1]
      t += d
      return s
    }),
  }))
}

function round2(n: number): number {
  return Math.round(n * 100) / 100
}


/** 生词词典：词性 + 中文翻译（自写释义，未抄任何网站内容）
 * key 与详情页生词匹配的归一化方式一致：小写、去掉非字母符号（撇号保留） */

export interface VocabEntry {
  pos: string
  meaningCn: string
}

export const VOCAB_DICT: Record<string, VocabEntry> = {
  // The Lost Key
  pocket: { pos: 'n.', meaningCn: '口袋' },
  carefully: { pos: 'adv.', meaningCn: '仔细地；认真地' },
  closet: { pos: 'n.', meaningCn: '衣柜；壁橱' },
  spare: { pos: 'adj.', meaningCn: '备用的' },
  // A Rainy Saturday
  picnic: { pos: 'n.', meaningCn: '野餐' },
  blanket: { pos: 'n.', meaningCn: '毯子' },
  kite: { pos: 'n.', meaningCn: '风筝' },
  sandwiches: { pos: 'n.', meaningCn: '三明治（sandwich 的复数）' },
  // The Old Bicycle
  garage: { pos: 'n.', meaningCn: '车库' },
  brakes: { pos: 'n.', meaningCn: '刹车（brake 的复数）' },
  chain: { pos: 'n.', meaningCn: '链条' },
  toolbox: { pos: 'n.', meaningCn: '工具箱' },
  // A Morning Walk
  fresh: { pos: 'adj.', meaningCn: '清新的；新鲜的' },
  wag: { pos: 'n.', meaningCn: '摇动（尾巴）' },
  energy: { pos: 'n.', meaningCn: '精力；能量' },
  smile: { pos: 'n.', meaningCn: '微笑；笑容' },
  // The Old Clock Tower
  repair: { pos: 'v.', meaningCn: '修理；修复' },
  engineer: { pos: 'n.', meaningCn: '工程师' },
  square: { pos: 'n.', meaningCn: '广场' },
  proud: { pos: 'adj.', meaningCn: '自豪的；骄傲的' },
}

/** 按详情页的归一化方式查词典（去标点、小写） */
export function lookupVocab(text: string): VocabEntry | undefined {
  return VOCAB_DICT[text.toLowerCase().replace(/[^a-z']/g, '')]
}
